<%- include('../../partials/head', { title: vm.name + ' - Overview' }) %>
<%- include('../../partials/ambient') %>
<%- include('../../partials/topbar') %>
<%- include('../../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3">
    <div>
      <div class="muted text-sm" style="margin-bottom:2px">
        <a href="/dashboard" style="color:var(--text-dim)">Servers</a> / <%= vm.name %>
      </div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.3px;display:flex;align-items:center;gap:12px">
        <%= vm.name %>
        <span id="statusPill" class="pill <%= vm.status === 'running' ? 'pill-green' : 'pill-gray' %>">
          <%= vm.status %>
        </span>
      </h2>
    </div>

    <!-- Power Controls Bar -->
    <div class="flex" style="gap:8px">
      <% if (vm.status === 'running') { %>
        <button class="btn btn-sm btn-danger" id="btnStop" onclick="power('stop')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
          Stop
        </button>
        <button class="btn btn-sm btn-primary" onclick="power('restart')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          Restart
        </button>
      <% } else { %>
        <button class="btn btn-sm btn-green" id="btnStart" onclick="power('start')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Start Server
        </button>
      <% } %>
      <a class="btn btn-sm" href="/servers/<%= vm.id %>/console">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
        Terminal
      </a>
    </div>
  </div>

  <%- include('_tabs') %>

  <!-- Spec Metrics Cards -->
  <div class="grid grid-4 mb-4">
    <div class="stat">
      <div class="stat-icon" style="background:rgba(99,102,241,0.15);color:#818cf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vm.cpus %></div>
        <div class="stat-label">vCPUs</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(56,189,248,0.15);color:#38bdf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vm.memory %> MB</div>
        <div class="stat-label">Memory (<%= (vm.memory/1024).toFixed(1) %> GB)</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#fbbf24">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vm.disk_size %></div>
        <div class="stat-label">Disk Storage</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#34d399">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l2 2M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>
      </div>
      <div>
        <div class="stat-value" id="statUptime"><%= vm.status === 'running' ? 'Active' : 'Offline' %></div>
        <div class="stat-label">Uptime</div>
      </div>
    </div>
  </div>

  <div class="grid grid-2">
    <!-- Server Details -->
    <div class="card">
      <div class="card-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        Instance Specifications
      </div>
      <div class="table-wrap">
        <table>
          <tbody>
            <tr><td class="muted" style="width:130px">UUID</td><td class="mono"><%= vm.uuid %></td></tr>
            <tr><td class="muted">Operating System</td><td><span class="pill pill-blue font-bold"><%= vm.os_type %> <%= vm.codename %></span></td></tr>
            <tr><td class="muted">Hostname</td><td class="mono"><%= vm.hostname %></td></tr>
            <tr><td class="muted">Username</td><td class="mono font-bold" style="color:#fff"><%= vm.username %></td></tr>
            <tr><td class="muted">SSH Port</td><td class="mono"><span style="color:var(--accent-2);font-weight:700">Port <%= vm.ssh_port %></span></td></tr>
            <tr><td class="muted">Web Terminal</td><td><a href="/servers/<%= vm.id %>/console" class="btn btn-sm">Launch Terminal</a></td></tr>
            <tr><td class="muted">Port Forwards</td><td class="mono"><% if (vm.port_forwards && vm.port_forwards.length) { %><% for (const f of vm.port_forwards) { %><span class="pill pill-gray" style="margin-right:4px"><%= f.host %>:<%= f.guest %></span><% } %><% } else { %><span class="muted">None configured</span><% } %></td></tr>
            <tr><td class="muted">Created At</td><td class="muted"><%= new Date(vm.created_at).toLocaleString() %></td></tr>
            <tr><td class="muted">Start on Panel Boot</td><td><%= vm.start_on_boot ? 'Yes (Automatic)' : 'No (Manual)' %></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Actions & Credentials -->
    <div class="card">
      <div class="card-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Quick Actions &amp; Management
      </div>
      <div class="flex flex-wrap mb-3" style="gap:10px">
        <a class="btn btn-primary" href="/servers/<%= vm.id %>/console">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
          Open Terminal
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/files">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          File Manager
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/backups">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Backups
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/schedules">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Schedules
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Settings
        </a>
        <button class="btn btn-danger" onclick="delServer()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
          Delete Server
        </button>
      </div>

      <hr class="hr"/>

      <!-- SSH Access Card Box -->
      <div style="background:rgba(0,0,0,0.3);border:1px solid var(--border);border-radius:12px;padding:16px">
        <div class="flex-between mb-2">
          <div style="font-weight:700;font-size:13px;color:#fff">Direct SSH Access</div>
          <button class="btn btn-sm" onclick="copyText('ssh -p <%= vm.ssh_port %> <%= vm.username %>@localhost')">Copy SSH</button>
        </div>
        <div class="mono" style="background:#060913;padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);color:var(--accent-2);font-size:13px;word-break:break-all">
          ssh -p <%= vm.ssh_port %> <%= vm.username %>@localhost
        </div>
        <div class="flex-between mt-2" style="font-size:12.5px">
          <span class="muted">Default Password:</span>
          <div class="flex" style="gap:6px">
            <span class="mono font-bold" style="color:#fff"><%= vm.password %></span>
            <button class="icon-btn" style="width:24px;height:24px" onclick="copyText('<%= vm.password %>')" title="Copy password">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../../partials/music') %>
<%- include('../../partials/foot') %>

<script>
function copyText(t) {
  navigator.clipboard.writeText(t)
    .then(() => VP.toast('Copied to clipboard!', 'success'))
    .catch(() => VP.toast('Failed to copy', 'error'));
}

async function power(action) {
  const btn = action === 'stop' ? document.getElementById('btnStop') : document.getElementById('btnStart');
  if (btn) btn.disabled = true;
  try {
    VP.toast(`Sending ${action} command...`, 'info');
    await VP.api(`/servers/<%= vm.id %>/power`, { method: 'POST', body: { action } });
    VP.toast(`Server ${action} command processed`, 'success');
    setTimeout(() => location.reload(), 800);
  } catch (e) {
    VP.toast(e.message, 'error');
    if (btn) btn.disabled = false;
  }
}

async function delServer() {
  const ok = await VP.confirmDialog('This will permanently delete <%= vm.name %> and ALL disk images and backups. This cannot be undone!', { title: 'Delete server?' });
  if (!ok) return;
  try {
    await VP.api(`/servers/<%= vm.id %>/delete`, { method: 'POST' });
    VP.toast('Server deleted', 'success');
    setTimeout(() => location.href = '/dashboard', 800);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

<% if (vm.status === 'running') { %>
fetch(vpApiBase() + `/api/vms/<%= vm.id %>/status`, { headers: { Authorization: 'Bearer ' + vpToken() } })
  .then(r => r.json())
  .then(d => {
    const up = document.getElementById('statUptime');
    if (up && d.uptime) {
      const h = Math.floor(d.uptime / 3600), m = Math.floor((d.uptime % 3600) / 60);
      up.textContent = h ? `${h}h ${m}m` : `${m}m`;
    }
  }).catch(()=>{});
<% } %>
</script>
