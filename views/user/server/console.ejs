<%- include('../../partials/head', { title: vm.name + ' - Terminal', styles: ['/vendor/xterm.min.css'], scripts: ['/socket.io/socket.io.js', '/vendor/xterm.min.js', '/vendor/addon-fit.min.js'] }) %>
<%- include('../../partials/ambient') %>
<%- include('../../partials/topbar') %>
<%- include('../../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3">
    <h2 style="font-size:22px">Terminal · <%= vm.name %></h2>
    <div class="flex" style="gap:8px">
      <span class="pill <%= vm.status === 'running' ? 'pill-green' : 'pill-gray' %>"><%= vm.status %></span>
      <a class="btn btn-sm" href="/servers/<%= vm.id %>">Back to overview</a>
    </div>
  </div>
  <%- include('_tabs') %>

  <div class="console-tabs" style="margin-bottom:14px">
    <button class="console-tab active" id="tabTerminal" onclick="switchView('terminal')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:-2px;margin-right:6px"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
      SSH Terminal
    </button>
    <button class="console-tab" id="tabBootLog" onclick="switchView('bootlog')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:-2px;margin-right:6px"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
      Boot &amp; Startup Logs
    </button>
  </div>

  <!-- SSH Terminal Pane -->
  <div id="paneTerminal" class="card" style="padding:16px">
    <div class="console-toolbar flex-between" style="margin-bottom:12px">
      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <span id="connState" class="pill pill-yellow">connecting...</span>
        <button class="btn btn-sm" id="btnReconnect" onclick="sshConnect()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          Reconnect
        </button>
        <button class="btn btn-sm" onclick="clearTerm()">Clear</button>
        <button class="btn btn-sm" onclick="sendCtrlC()" title="Send Interrupt Signal (Ctrl+C)">Ctrl+C</button>
        <button class="btn btn-sm" onclick="sendCtrlD()" title="Send EOF (Ctrl+D)">Ctrl+D</button>
      </div>
      <div class="flex" style="gap:8px;align-items:center">
        <span class="muted mono text-sm" style="font-size:12px">ssh -p <%= vm.ssh_port %> <%= vm.username %>@localhost</span>
        <button class="btn btn-sm" onclick="fitTerm()">Fit</button>
      </div>
    </div>
    <div class="terminal" id="terminal" style="min-height:500px;height:calc(100vh - 350px);background:#090d16"></div>
  </div>

  <!-- Boot Logs Pane -->
  <div id="paneBootLog" class="card" style="padding:16px;display:none">
    <div class="console-toolbar flex-between" style="margin-bottom:12px">
      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <span id="bootState" class="pill pill-blue">Boot Output</span>
        <button class="btn btn-sm btn-primary" onclick="loadBootLog(true)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          Refresh Logs
        </button>
        <label class="check" style="font-size:13px;margin:0;cursor:pointer">
          <input type="checkbox" id="autoRefreshBoot" checked onchange="toggleAutoBoot(this.checked)"/> Auto-refresh (3s)
        </label>
        <button class="btn btn-sm" onclick="copyBootLog()">Copy Logs</button>
      </div>
      <div class="flex" style="gap:8px;align-items:center">
        <span class="muted text-sm" style="font-size:12px">Serial Console &amp; QEMU Startup</span>
      </div>
    </div>
    <pre id="bootLogContent" style="min-height:500px;height:calc(100vh - 350px);background:#090d16;color:#38bdf8;padding:16px;border-radius:12px;border:1px solid var(--border);font-family:JetBrains Mono, Menlo, Monaco, Consolas, monospace;font-size:13px;line-height:1.45;overflow:auto;white-space:pre-wrap;word-break:break-all;margin:0">Loading boot logs...</pre>
  </div>
</div>
<%- include('../../partials/music') %>
<%- include('../../partials/foot') %>
<script>
(function () {
  const termEl = document.getElementById('terminal');
  const stateEl = document.getElementById('connState');
  let term, fit, socket, connected = false;
  let activeTab = 'terminal';
  let bootLogTimer = null;

  function setState(text, cls) {
    stateEl.textContent = text;
    stateEl.className = 'pill ' + (cls || 'pill-yellow');
  }

  function initTerm() {
    if (term) { term.dispose(); term = null; }
    term = new Terminal({
      cursorBlink: true,
      cursorStyle: 'block',
      fontSize: 14,
      fontFamily: 'JetBrains Mono, Menlo, Monaco, Consolas, "Courier New", monospace',
      letterSpacing: 0,
      lineHeight: 1.2,
      theme: {
        background: '#090d16',
        foreground: '#e2e8f0',
        cursor: '#38bdf8',
        cursorAccent: '#090d16',
        selectionBackground: 'rgba(56, 189, 248, 0.3)',
        black: '#1e293b',
        red: '#f87171',
        green: '#4ade80',
        yellow: '#facc15',
        blue: '#60a5fa',
        magenta: '#c084fc',
        cyan: '#38bdf8',
        white: '#f8fafc',
        brightBlack: '#475569',
        brightRed: '#ef4444',
        brightGreen: '#22c55e',
        brightYellow: '#eab308',
        brightBlue: '#3b82f6',
        brightMagenta: '#a855f7',
        brightCyan: '#06b6d4',
        brightWhite: '#ffffff'
      },
      scrollback: 10000,
      convertEol: true,
    });
    fit = new FitAddon.FitAddon();
    term.loadAddon(fit);
    term.open(termEl);
    setTimeout(() => { try { fit.fit(); } catch (e) {} }, 100);

    term.onData((data) => {
      if (connected && socket) socket.emit('console:input', data);
    });

    window.addEventListener('resize', () => {
      if (activeTab === 'terminal') {
        try {
          fit.fit();
          sshResize();
        } catch (e) {}
      }
    });

    term.onResize(({ cols, rows }) => {
      if (socket && connected) socket.emit('console:resize', { cols, rows });
    });
  }

  function sshResize() {
    if (term && socket && connected) {
      socket.emit('console:resize', { cols: term.cols, rows: term.rows });
    }
  }

  window.sshConnect = function sshConnect() {
    if (socket) { socket.disconnect(); socket = null; }
    setState('connecting...', 'pill-yellow');
    socket = io({
      transports: ['websocket', 'polling'],
      auth: { token: vpToken() },
      reconnection: true,
      reconnectionDelay: 2000,
    });

    socket.on('connect', () => {
      setState('connected', 'pill-green');
      connected = true;
      socket.emit('console:join', { vmId: <%= vm.id %> });
      setTimeout(() => {
        try { fit.fit(); sshResize(); } catch (e) {}
      }, 200);
    });

    socket.on('console:ready', () => {
      setState('streaming', 'pill-green');
      term.clear();
      term.focus();
    });

    socket.on('console:data', (d) => {
      if (term) term.write(d);
    });

    socket.on('console:error', (m) => {
      setState('error', 'pill-red');
      if (term) term.writeln('\r\n\x1b[31m[Error] ' + m + '\x1b[0m\r\n');
    });

    socket.on('console:close', () => {
      setState('stream closed', 'pill-gray');
      connected = false;
    });

    socket.on('disconnect', () => {
      connected = false;
      setState('disconnected - retrying...', 'pill-yellow');
    });

    socket.on('connect_error', () => {
      setState('cannot reach terminal server', 'pill-red');
    });
  };

  window.clearTerm = function () {
    if (term) term.clear();
  };

  window.fitTerm = function () {
    if (fit && term) {
      try {
        fit.fit();
        sshResize();
        term.focus();
      } catch (e) {}
    }
  };

  window.sendCtrlC = function () {
    if (connected && socket) {
      socket.emit('console:input', '\x03');
      if (term) term.focus();
    }
  };

  window.sendCtrlD = function () {
    if (connected && socket) {
      socket.emit('console:input', '\x04');
      if (term) term.focus();
    }
  };

  // ---------------- Boot Logs ----------------
  async function loadBootLog(notify = false) {
    try {
      const r = await fetch('/servers/<%= vm.id %>/bootlog', { headers: { Authorization: 'Bearer ' + vpToken() } });
      const d = await r.json();
      const el = document.getElementById('bootLogContent');
      if (d.ok && d.log) {
        const atBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 40;
        el.textContent = d.log;
        if (atBottom || notify) el.scrollTop = el.scrollHeight;
      } else {
        el.textContent = '[Boot Log] No boot output yet.';
      }
      if (notify) VP.toast('Boot logs refreshed', 'info');
    } catch (e) {
      if (notify) VP.toast(e.message, 'error');
    }
  }
  window.loadBootLog = loadBootLog;

  window.toggleAutoBoot = function (enabled) {
    if (bootLogTimer) { clearInterval(bootLogTimer); bootLogTimer = null; }
    if (enabled && activeTab === 'bootlog') {
      bootLogTimer = setInterval(() => loadBootLog(false), 3000);
    }
  };

  window.copyBootLog = function () {
    const text = document.getElementById('bootLogContent').textContent;
    navigator.clipboard.writeText(text)
      .then(() => VP.toast('Boot logs copied to clipboard!', 'success'))
      .catch(() => VP.toast('Failed to copy', 'error'));
  };

  // ---------------- Tab Switching ----------------
  window.switchView = function switchView(tab) {
    activeTab = tab;
    document.getElementById('tabTerminal').classList.toggle('active', tab === 'terminal');
    document.getElementById('tabBootLog').classList.toggle('active', tab === 'bootlog');
    document.getElementById('paneTerminal').style.display = tab === 'terminal' ? 'block' : 'none';
    document.getElementById('paneBootLog').style.display = tab === 'bootlog' ? 'block' : 'none';

    if (tab === 'terminal') {
      if (bootLogTimer) { clearInterval(bootLogTimer); bootLogTimer = null; }
      setTimeout(() => {
        try { fit.fit(); sshResize(); term.focus(); } catch (e) {}
      }, 100);
    } else if (tab === 'bootlog') {
      loadBootLog(false);
      const auto = document.getElementById('autoRefreshBoot').checked;
      if (auto) {
        if (bootLogTimer) clearInterval(bootLogTimer);
        bootLogTimer = setInterval(() => loadBootLog(false), 3000);
      }
    }
  };

  initTerm();
  sshConnect();
})();
</script>
