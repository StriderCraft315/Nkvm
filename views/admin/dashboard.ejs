<%- include('../partials/head', { title: 'Admin Overview' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3">
    <h2 style="font-size:22px">Admin Overview</h2>
    <a class="btn btn-primary" href="/admin/servers/create"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg> Create VM</a>
  </div>

  <div class="grid grid-4 mb-3">
    <div class="card stat"><div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg></div><div><div class="stat-value"><%= vms.length %></div><div class="stat-label">Total VMs</div></div></div>
    <div class="card stat"><div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div><div><div class="stat-value" style="color:var(--green)"><%= running %></div><div class="stat-label">Running</div></div></div>
    <div class="card stat"><div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div><div class="stat-value"><%= users.length %></div><div class="stat-label">Users</div></div></div>
    <div class="card stat"><div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg></div><div><div class="stat-value"><%= totalDisk %><span style="font-size:13px;color:var(--text-dim)"> GB</span></div><div class="stat-label">Allocated Disk</div></div></div>
  </div>

  <div class="card">
    <div class="card-title">System Status</div>
    <div class="grid grid-3">
      <div class="flex"><span class="pill <%= usage.qemu ? 'pill-green' : 'pill-red' %>"><%= usage.qemu ? 'installed' : 'missing' %></span><span>QEMU</span></div>
      <div class="flex"><span class="pill <%= usage.cloudLocalds ? 'pill-green' : 'pill-red' %>"><%= usage.cloudLocalds ? 'installed' : 'missing' %></span><span>cloud-localds</span></div>
      <div class="flex"><span class="pill <%= usage.wget ? 'pill-green' : 'pill-red' %>"><%= usage.wget ? 'installed' : 'missing' %></span><span>wget</span></div>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-title">All Servers</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Server</th><th>Owner</th><th>OS</th><th>SSH Port</th><th>Status</th><th class="right">Actions</th></tr></thead>
        <tbody>
        <% for (const v of vms) { %>
          <tr>
            <td><a href="/admin/servers/<%= v.id %>" style="font-weight:600;color:var(--text)"><%= v.name %></a></td>
            <td class="muted"><%= v.owner_name %></td>
            <td><span class="pill pill-blue"><%= v.os_type || '-' %></span></td>
            <td class="mono"><%= v.ssh_port %></td>
            <td><span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>"><%= v.status %></span></td>
            <td class="right">
              <div class="flex right" style="gap:6px">
                <% if (v.status === 'running') { %><button class="btn btn-sm" onclick="action(<%= v.id %>,'stop')">Stop</button><% } else { %><button class="btn btn-sm btn-green" onclick="action(<%= v.id %>,'start')">Start</button><% } %>
                <a class="btn btn-sm" href="/admin/servers/<%= v.id %>">Manage</a>
              </div>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-title">Recent Global Activity</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Event</th><th>User</th><th>Details</th><th>When</th></tr></thead>
        <tbody>
        <% for (const a of recentLogs) { %>
          <tr>
            <td><span class="pill pill-blue"><%= a.event %></span></td>
            <td><%= a.username || 'System' %></td>
            <td class="muted truncate" style="max-width:320px"><%= a.details ? JSON.stringify(a.details) : '-' %></td>
            <td class="muted"><%= new Date(a.created_at).toLocaleString() %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script>
async function action(id, a) {
  try {
    await VP.api('/admin/servers/' + id + '/action', { method: 'POST', body: { action: a } });
    VP.toast('Command sent', 'success');
    setTimeout(() => location.reload(), 900);
  } catch (e) { VP.toast(e.message, 'error'); }
}
</script>
