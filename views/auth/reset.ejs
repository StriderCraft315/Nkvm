<%- include('../partials/head', { title: 'Reset Password' }) %>
<%- include('../partials/ambient') %>
<div class="auth-wrap">
  <div class="auth-card">
    <h1 class="auth-title">Reset password</h1>
    <p class="auth-sub">Choose a new password for your account</p>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="auth-foot"><a href="/login">Sign in now</a></div>
    <% } else { %>
    <form method="post" action="/reset">
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>"/>
      <div class="form-group">
        <label for="password">New Password</label>
        <input type="password" id="password" name="password" required/>
      </div>
      <div class="form-group">
        <label for="password2">Confirm Password</label>
        <input type="password" id="password2" name="password2" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Set New Password</button>
    </form>
    <div class="auth-foot"><a href="/login">Back to login</a></div>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
