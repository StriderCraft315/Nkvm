<%
const musicMode = settings['panel.music_mode'] || 'none';
const volume = parseInt(settings['panel.music_volume'] || '35', 10);
const autoplay = settings['panel.music_autoplay'] === '1';
const loop = settings['panel.music_loop'] === '1';
let musicSrc = '';
let isYt = false;
if (musicMode === 'upload' && settings['panel.music_file']) musicSrc = settings['panel.music_file'];
else if (musicMode === 'url' && settings['panel.music_url']) musicSrc = settings['panel.music_url'];
else if (musicMode === 'youtube' && settings['panel.music_youtube']) { isYt = true; }
const showPlayer = musicMode !== 'none' && (musicSrc || isYt);
%>
<% if (showPlayer) { %>
<div class="music-player" id="musicPlayer">
  <% if (isYt) { %>
    <iframe src="https://www.youtube-nocookie.com/embed/<%= settings['panel.music_youtube'] %>?autoplay=<%= autoplay ? 1 : 0 %>&loop=<%= loop ? 1 : 0 %>&playsinline=1&playlist=<%= settings['panel.music_youtube'] %>" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
  <% } else { %>
    <audio id="panelAudio" src="<%= musicSrc %>" controls <%= autoplay ? 'autoplay' : '' %> <%= loop ? 'loop' : '' %> preload="metadata"></audio>
    <script>
      (function () {
        var a = document.getElementById('panelAudio');
        if (!a) return;
        a.volume = Math.min(1, Math.max(0, <%= volume / 100 %>));
        if (!<%= autoplay ? 'true' : 'false' %>) { a.play().catch(function(){}); }
        document.addEventListener('click', function onFirst() {
          if (a.paused) a.play().catch(function(){});
        }, { once: true });
      })();
    </script>
  <% } %>
</div>
<% } %>
